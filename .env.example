# Read-only reuse of the original project's GPT reference image service.
CAR2LEGO_SOURCE_ROOT=D:/lego
# Optional Python with the original service dependencies installed.
# CAR2LEGO_SOURCE_PYTHON=D:/python/anaconda/python.exe
# API configuration is inherited from CAR2LEGO_SOURCE_ROOT/backend/.env.
# Sequential groups of five; next group starts only after all five succeed.
# Maximum active reference calls within each group (1..5, default 5). HTTP 429 lowers it.
# CAR2LEGO_REFERENCE_CONCURRENCY=5
# Optional direct dialogue model override (must support vision for exterior and detail evidence).
# CAR2LEGO_SPEC_MODEL=gpt-6.1-sol
